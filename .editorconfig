# Editor defaults that match .clang-format for files clang-format does not touch.
root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 4

[*.{md,yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab

[vendor/**]
# Vendor code keeps its own style; never reformat it.
trim_trailing_whitespace = unset
insert_final_newline     = unset
indent_style             = unset
indent_size              = unset
